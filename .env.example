# ==============================================================================
# AI Job Application Agent - Environment Configuration
# ==============================================================================

# Application Meta
APP_NAME="AI Job Application Agent"
APP_VERSION="0.5.0"
ENVIRONMENT="development" # development | production | testing
DEBUG=true

# Server Configuration
HOST="127.0.0.1"
PORT=8000
API_V1_STR="/api/v1"

# Database Configuration (Local SQLite)
DATABASE_URL="sqlite:///./data/job_agent.db"

# CORS Configuration (JSON array of strings)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Structured Logging
LOG_LEVEL="INFO" # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT="console" # console | json

# Local Storage Directory (for resumes, logs, exports)
STORAGE_DIR="./data/storage"

# Local LLM Configuration (Ollama on Apple Silicon GPU)
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen3:8b"
OLLAMA_TIMEOUT_SECONDS=120.0
OLLAMA_TEMPERATURE=0.2
